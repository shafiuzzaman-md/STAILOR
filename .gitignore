# --- Existing Data & External Resources ---
runs/
codeql-db/
dataset/
**/llm_usage.tsv
**/*.bc

# --- Python ---
__pycache__/
*.py[cod]
*$py.class

# --- Specs ---
specs/**

# ===============
#OUTPUT HANDLING
# ===============

# 1. Ignore ALL content in output directories by default
se_runs/

# 2. Re-include directories so we can selectively unignore files
# (Git cannot track files inside ignored folders unless the folder itself is un-ignored)
!se_runs/**/

# 3) Ignore all files under se_runs (after dirs are re-included)
se_runs/**/*
se_runs/**/.*

# 4) Allow only the artifacts you want to track
!se_runs/**/summary.tsv
!se_runs/**/summary_agg.csv
!se_runs/**/summary_agg.tsv
!se_runs/**/summary_agg.html
!se_runs/**/time.log
!se_runs/**/errors.log
!se_runs/**/counts.csv
!se_runs/**/counts.tsv
!se_runs/**/auto_validation_policy.yaml
!se_runs/**/execution.log
!se_runs/**/instrumentation.actions
!se_runs/**/instrumented_build.stderr

# Keep the Plan (Logic) & Policy
!**/frozen_plan.json
!**/auto_validation_policy.yaml

# Keep Execution Metadata (Stats, Tokens)
!**/run_meta.json
!**/context.json

# Keep the Proofs (Harness & Success Flag)
!**/harness.c
!**/reproduction_success.txt

# =======================================================
# HARD IGNORES (Garbage Collection)
# =======================================================
# Even if un-ignored above, force-ignore these specific bulk files
**/klee-out-*/
**/klee-last/
**/prompts_snapshots/
**/*_messages.json
**/*_raw_response.txt
**/*_response.txt
**/*.ktest
**/*.o
**/*.a
**/*.gcno
**/*.gcda

# CodeQL output
**/codeql-results.sarif
