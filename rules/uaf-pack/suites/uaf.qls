# rules/uaf-pack/suites/uaf.qls

- description: Stock UAF baseline (built-in CodeQL)
  from: codeql/cpp-queries
  queries: .
  include:
    id: [ cpp/use-after-free ]

- description: CWE-416 free-then-use (intra; field-collapse x->f/x.f; deref/call/return)
  query: queries/cwe-416-free-then-use-intra-fieldcollapse.ql

- description: CWE-416 free-then-dereference (intra)
  query: queries/cwe-416-free-then-deref-intra.ql

- description: CWE-416 free-then-call-arg (intra; field-collapse + light agg steps)
  query: queries/cwe-416-free-then-callarg-intra-fieldcollapse.ql

- description: CWE-416 lookup→remove→use (intra)
  query: queries/cwe-416-lookup-remove-use-intra.ql

- description: libxml2 CWE-416 free-then-use (intra; field-collapse)
  query: queries/cwe-416-libxml2-free-then-use-intra-fieldcollapse.ql

- description: libxml2 CWE-416 free-then-dereference (intra)
  query: queries/cwe-416-libxml2-free-then-deref-intra.ql

- description: libxml2 CWE-416 free-then-call-arg (intra; field-collapse + light agg steps)
  query: queries/cwe-416-libxml2-free-then-callarg-intra-fieldcollapse.ql

- query: queries/libxml2-free-then-arg-intra.ql
- query: queries/free-then-use-intra-any.ql

