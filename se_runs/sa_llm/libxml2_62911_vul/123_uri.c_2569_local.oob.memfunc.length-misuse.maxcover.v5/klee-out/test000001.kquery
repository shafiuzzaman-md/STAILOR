array memset_size[8] : w32 -> w8 = symbolic
array uri[88] : w32 -> w8 = symbolic
array uri_str[256] : w32 -> w8 = symbolic
(query [(Eq 0 (Read w8 255 uri_str))
         (Eq 0
             (ReadLSB w64 48 uri))
         (Eq false
             (Ule (ReadLSB w64 0 memset_size)
                  88))]
        false)
