array chartab_size[8] : w32 -> w8 = symbolic
array memset_len[8] : w32 -> w8 = symbolic
(query [(Eq 127
             (ReadLSB w64 0 chartab_size))
         (Ult 0
              N0:(ReadLSB w64 0 memset_len))
         (Ule N0 2048)
         (Ule N0 127)
         (Eq false
             (Ult 0 (Add w64 18446744073709551615 N0)))]
        false)
