array buf[256] : w32 -> w8 = symbolic
array dec_total[4] : w32 -> w8 = symbolic
array i_symbolic[4] : w32 -> w8 = symbolic
(query [(Ult N0:(Add w64 128
                          (ZExt w64 N1:(ReadLSB w32 0 i_symbolic)))
              256)
         (Eq false
             (Eq 0
                 (Read w8 (Extract w32 0 N0)
                          buf)))
         (Sle 128
              (ZExt w64 N2:(Add w32 1 N1)))
         (Ult N2
              (ReadLSB w32 0 dec_total))]
        false)
