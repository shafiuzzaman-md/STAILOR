array len[4] : w32 -> w8 = symbolic
array rlen[4] : w32 -> w8 = symbolic
array segment_buf[1024] : w32 -> w8 = symbolic
(query [(Eq 0 (Read w8 1023 segment_buf))
         (Sle 0
              N0:(ReadLSB w32 0 len))
         (Ult (SExt w64 N0) 1024)
         (Sle 0
              (ReadLSB w32 0 rlen))]
        false)
