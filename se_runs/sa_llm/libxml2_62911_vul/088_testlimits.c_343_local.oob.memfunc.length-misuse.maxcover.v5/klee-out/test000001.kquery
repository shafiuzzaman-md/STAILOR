array buffer_size[4] : w32 -> w8 = symbolic
array curlen[4] : w32 -> w8 = symbolic
array instate[4] : w32 -> w8 = symbolic
array len[4] : w32 -> w8 = symbolic
array rlen[4] : w32 -> w8 = symbolic
(query [(Ule 0
              (ReadLSB w32 0 len))
         (Ule 0
              (ReadLSB w32 0 rlen))
         (Ule 0
              (ReadLSB w32 0 curlen))
         (Ule (ReadLSB w32 0 instate)
              3)
         (Eq false
             (Ule 1
                  (ReadLSB w32 0 buffer_size)))]
        false)
