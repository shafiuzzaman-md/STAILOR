array enc_alloc_fails[4] : w32 -> w8 = symbolic
array icv_in_valid[4] : w32 -> w8 = symbolic
array icv_out_valid[4] : w32 -> w8 = symbolic
(query [(Sle 0
              (ReadLSB w32 0 icv_in_valid))
         (Sle 0
              (ReadLSB w32 0 icv_out_valid))
         (Eq false
             (Eq 0
                 (ReadLSB w32 0 enc_alloc_fails)))]
        false)
