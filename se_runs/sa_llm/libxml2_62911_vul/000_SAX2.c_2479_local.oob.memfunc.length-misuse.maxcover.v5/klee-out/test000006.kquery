array len[4] : w32 -> w8 = symbolic
array nodelen[4] : w32 -> w8 = symbolic
array nodemem[4] : w32 -> w8 = symbolic
(query [(Sle 0
              N0:(ReadLSB w32 0 nodelen))
         (Slt N0 1024)
         (Sle 1 (Add w32 127 N0))
         (Eq 1
             (ReadLSB w32 0 nodemem))
         (Eq 127
             (ReadLSB w32 0 len))
         (Eq false (Eq 0 N0))]
        false)
