array base[256] : w32 -> w8 = symbolic
array len[4] : w32 -> w8 = symbolic
(query [(Sle 0
              N0:(ReadLSB w32 0 len))
         (Ult N1:(SExt w64 N0) 256)
         (Eq false (Ult 0 N1))
         (Eq 95
             (Read w8 (Extract w32 0 N1)
                      [255=0] @ base))]
        false)
