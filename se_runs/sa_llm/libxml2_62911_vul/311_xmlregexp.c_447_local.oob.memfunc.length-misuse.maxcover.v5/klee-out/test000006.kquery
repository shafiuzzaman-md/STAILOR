array check_dim1[8] : w32 -> w8 = symbolic
array check_dim2[8] : w32 -> w8 = symbolic
array check_elemSize[8] : w32 -> w8 = symbolic
array dim1[8] : w32 -> w8 = symbolic
array dim2[8] : w32 -> w8 = symbolic
array elemSize[8] : w32 -> w8 = symbolic
(query [(Ule N0:(ReadLSB w64 0 dim1)
              1024)
         (Ule N1:(ReadLSB w64 0 dim2)
              1024)
         (Ule N2:(ReadLSB w64 0 elemSize)
              1024)
         (Eq false (Eq 0 N0))
         (Eq false (Eq 0 N1))
         (Eq false (Eq 0 N2))
         (Eq 128
             (Mul w64 (Mul w64 N0 N1) N2))
         (Ult 0
              N3:(ReadLSB w64 0 check_dim1))
         (Ult 0
              N4:(ReadLSB w64 0 check_dim2))
         (Ult 0
              N5:(ReadLSB w64 0 check_elemSize))
         (Ult (UDiv w64 (UDiv w64 18446744073709551615 N4) N5)
              N3)]
        false)
