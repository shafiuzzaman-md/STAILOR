array len[4] : w32 -> w8 = symbolic
array size[4] : w32 -> w8 = symbolic
array use[4] : w32 -> w8 = symbolic
(query [(Eq 0
             (ReadLSB w32 0 len))
         (Sle 0
              N0:(ReadLSB w32 0 use))
         (Slt N0 1024)
         (Sle 0
              N1:(ReadLSB w32 0 size))
         (Slt N1 2048)]
        false)
