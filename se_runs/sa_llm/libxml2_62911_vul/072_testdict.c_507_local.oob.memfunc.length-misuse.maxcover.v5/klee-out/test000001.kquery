array num_entries[4] : w32 -> w8 = symbolic
array num_keys[4] : w32 -> w8 = symbolic
(query [(Sle 0
              N0:(ReadLSB w32 0 num_entries))
         (Sle N0 1000)
         (Sle 0
              N1:(ReadLSB w32 0 num_keys))
         (Sle N1 1000)
         (Eq false
             (Eq 0
                 (Mul w64 8
                          (SExt w64 (Mul w32 N0 N1)))))]
        false)
