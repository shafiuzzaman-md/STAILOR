array ctxt[96] : w32 -> w8 = symbolic
array read_len[4] : w32 -> w8 = symbolic
(query [(Sle 0
              N0:(ReadLSB w32 0 read_len))
         (Slt N0 2048)
         (Ule N1:(ReadLSB w64 8 ctxt)
              N2:(ReadLSB w64 0 ctxt))
         (Sle 0 N3:(Sub w64 N2 N1))
         (Slt N3 2048)
         (Eq false (Eq 0 N0))]
        false)
