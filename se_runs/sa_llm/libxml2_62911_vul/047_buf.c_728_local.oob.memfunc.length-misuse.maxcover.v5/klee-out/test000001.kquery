array buf_size[8] : w32 -> w8 = symbolic
array buf_use[8] : w32 -> w8 = symbolic
array len[4] : w32 -> w8 = symbolic
(query [(Ult (ReadLSB w64 0 buf_use)
              4096)
         (Ult (ReadLSB w64 0 buf_size)
              4096)
         (Eq false
             (Sle 0
                  (ReadLSB w32 0 len)))]
        false)
