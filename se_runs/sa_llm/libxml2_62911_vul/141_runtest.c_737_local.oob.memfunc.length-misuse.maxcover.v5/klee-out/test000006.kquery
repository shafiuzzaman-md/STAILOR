array idx[4] : w32 -> w8 = symbolic
array memcmp_n[8] : w32 -> w8 = symbolic
array read_res[8] : w32 -> w8 = symbolic
array size[4] : w32 -> w8 = symbolic
(query [(Sle 0
              N0:(ReadLSB w32 0 idx))
         (Sle 0
              N1:(ReadLSB w32 0 size))
         (Sle N1 4096)
         (Sle N0 N1)
         (Sle 18446744073709551615
              N2:(ReadLSB w64 0 read_res))
         (Sle N2 4096)
         (Eq false (Sle N2 0))
         (Eq false
             (Slt (SExt w64 N1)
                  (Add w64 N2 (SExt w64 N0))))
         (Ule (ReadLSB w64 0 memcmp_n)
              4096)]
        false)
