array len[4] : w32 -> w8 = symbolic
array lenread[4] : w32 -> w8 = symbolic
array xml_len[4] : w32 -> w8 = symbolic
(query [(Sle 0
              N0:(ReadLSB w32 0 len))
         (Slt N0 1024)
         (Sle 0
              N1:(ReadLSB w32 0 xml_len))
         (Ult (SExt w64 N1) 2048)
         (Sle 0
              N2:(ReadLSB w32 0 lenread))
         (Slt N0 N2)
         (Eq false
             (Ult 0 (SExt w64 N0)))]
        false)
