array buffer_size[4] : w32 -> w8 = symbolic
array dec[8] : w32 -> w8 = symbolic
(query [(Slt 0
              N0:(ReadLSB w32 0 buffer_size))
         (Sle 0
              N1:(ReadLSB w32 4 dec))
         (Sle 0
              N2:(ReadLSB w32 0 dec))
         (Sle N2 N1)
         (Eq false (Eq 1 N0))]
        false)
