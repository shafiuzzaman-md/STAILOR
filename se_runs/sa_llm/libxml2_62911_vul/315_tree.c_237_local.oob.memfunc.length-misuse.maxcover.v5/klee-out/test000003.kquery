array lenn[4] : w32 -> w8 = symbolic
array lenp[4] : w32 -> w8 = symbolic
array memory[8] : w32 -> w8 = symbolic
(query [(Eq false
             (Slt N0:(ReadLSB w32 0 lenp)
                  0))
         (Eq false
             (Slt N1:(ReadLSB w32 0 lenn)
                  0))
         (Eq false (Eq 0 N0))
         (Ult 2147483648
              (SExt w64 (Add w32 1 N0)))
         (Eq false (Eq 0 N1))
         (Ult 2147483648
              (SExt w64 (Add w32 1 N1)))
         (Eq false
             (Eq 0
                 (ReadLSB w64 0 memory)))]
        false)
