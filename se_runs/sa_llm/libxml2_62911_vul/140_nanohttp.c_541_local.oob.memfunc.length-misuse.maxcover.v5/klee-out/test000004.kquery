array d_content[4] : w32 -> w8 = symbolic
array d_inptr[4] : w32 -> w8 = symbolic
array d_inrptr[4] : w32 -> w8 = symbolic
array recv_len[8] : w32 -> w8 = symbolic
array recv_result[8] : w32 -> w8 = symbolic
(query [(Sle 0
              N0:(ReadLSB w32 0 d_inptr))
         (Slt N0 4096)
         (Sle 0
              N1:(ReadLSB w32 0 d_content))
         (Slt N1 4096)
         (Sle 0
              N2:(ReadLSB w32 0 d_inrptr))
         (Slt N2 4096)
         (Ule (ReadLSB w64 0 recv_len)
              4096)
         (Eq false
             (Sle 18446744073709551615
                  (ReadLSB w64 0 recv_result)))]
        false)
