array alloc_size[8] : w32 -> w8 = symbolic
array alloc_success[4] : w32 -> w8 = symbolic
array choice[4] : w32 -> w8 = symbolic
(query [(Sle 0
              (ReadLSB w32 0 choice))
         (Eq 1
             (ReadLSB w32 0 alloc_success))
         (Ule 4
              (ReadLSB w64 0 alloc_size))]
        false)
