array dst[4096] : w32 -> w8 = symbolic
array size[8] : w32 -> w8 = symbolic
(query [(Eq 0
             (ReadLSB w64 0 size))
         (Eq false
             (Slt N0:(ReadLSB w32 128 dst)
                  (ReadLSB w32 0 dst)))
         (Slt N0
              N1:(ReadLSB w32 4 dst))
         (Eq false
             (Slt N2:(ReadLSB w32 132 dst)
                  N1))
         (Eq false
             (Slt N2
                  (ReadLSB w32 8 dst)))
         (Eq false
             (Slt N2
                  (ReadLSB w32 12 dst)))
         (Eq false
             (Slt N2
                  (ReadLSB w32 16 dst)))
         (Eq false
             (Slt N2
                  (ReadLSB w32 20 dst)))
         (Eq false
             (Slt N2
                  (ReadLSB w32 24 dst)))
         (Eq false
             (Slt N2
                  (ReadLSB w32 28 dst)))
         (Eq false
             (Slt N2
                  (ReadLSB w32 32 dst)))
         (Slt N2
              N3:(ReadLSB w32 36 dst))
         (Slt (ReadLSB w32 136 dst)
              N3)
         (Slt (ReadLSB w32 140 dst)
              N3)
         (Slt (ReadLSB w32 144 dst)
              N3)
         (Eq false
             (Slt (ReadLSB w32 148 dst)
                  N3))]
        false)
