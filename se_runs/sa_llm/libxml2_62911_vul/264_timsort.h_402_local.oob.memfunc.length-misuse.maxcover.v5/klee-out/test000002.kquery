array A[4] : w32 -> w8 = symbolic
array B[4] : w32 -> w8 = symbolic
array curr[4] : w32 -> w8 = symbolic
array size[4] : w32 -> w8 = symbolic
(query [(Sle 0
              N0:(ReadLSB w32 0 size))
         (Sle N0 1024)
         (Eq 0
             (Mul w64 4 (SExt w64 N0)))
         (Sle 0
              N1:(ReadLSB w32 0 curr))
         (Sle 0
              N2:(ReadLSB w32 0 A))
         (Sle 0
              N3:(ReadLSB w32 0 B))
         (Sle (Add w32 N4:(Add w32 N1 N2) N3)
              N0)
         (Sle 0 N4)
         (Eq false (Sle N3 N0))]
        false)
