array dst[4096] : w32 -> w8 = symbolic
array size[8] : w32 -> w8 = symbolic
(query [(Eq 0
             (ReadLSB w64 0 size))
         (Slt (ReadLSB w32 128 dst)
              N0:(ReadLSB w32 0 dst))
         (Slt (ReadLSB w32 132 dst)
              N0)
         (Slt (ReadLSB w32 136 dst)
              N0)
         (Slt (ReadLSB w32 140 dst)
              N0)
         (Slt (ReadLSB w32 144 dst)
              N0)
         (Slt (ReadLSB w32 148 dst)
              N0)
         (Eq false
             (Slt N1:(ReadLSB w32 152 dst)
                  N0))
         (Slt N1
              N2:(ReadLSB w32 4 dst))
         (Slt (ReadLSB w32 156 dst)
              N2)
         (Slt (ReadLSB w32 160 dst)
              N2)
         (Slt (ReadLSB w32 164 dst)
              N2)
         (Slt (ReadLSB w32 168 dst)
              N2)
         (Slt (ReadLSB w32 172 dst)
              N2)
         (Slt (ReadLSB w32 176 dst)
              N2)
         (Slt (ReadLSB w32 180 dst)
              N2)
         (Slt (ReadLSB w32 184 dst)
              N2)
         (Slt (ReadLSB w32 188 dst)
              N2)]
        false)
