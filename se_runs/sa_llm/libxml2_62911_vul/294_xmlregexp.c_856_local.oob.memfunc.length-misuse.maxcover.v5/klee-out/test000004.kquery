array atom[32] : w32 -> w8 = symbolic
(query [(Sle 0
              N0:(ReadLSB w32 0 atom))
         (Sle N0 10)
         (Sle 0
              N1:(ReadLSB w32 4 atom))
         (Sle N1 10)
         (Sle 0
              N2:(ReadLSB w32 8 atom))
         (Sle N2 1000)
         (Eq false
             (Sle 0
                  (ReadLSB w32 12 atom)))]
        false)
