array attrInfosSize[4] : w32 -> w8 = symbolic
array initial_nbAttrInfos[4] : w32 -> w8 = symbolic
(query [(Sle 0
              N0:(ReadLSB w32 0 attrInfosSize))
         (Sle N0 1024)
         (Eq 0
             (Mul w64 8 (SExt w64 N0)))
         (Eq false
             (Sle 0
                  (ReadLSB w32 0 initial_nbAttrInfos)))]
        false)
