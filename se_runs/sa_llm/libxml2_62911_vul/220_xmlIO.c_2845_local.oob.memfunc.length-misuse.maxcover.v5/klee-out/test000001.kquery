array ctxt_size[8] : w32 -> w8 = symbolic
array size[4] : w32 -> w8 = symbolic
(query [(Sle 0
              N0:(ReadLSB w32 0 size))
         (Sle N0 1024)
         (Ule N1:(ReadLSB w64 0 ctxt_size)
              2048)
         (Eq false
             (Ult N1 N2:(SExt w64 N0)))
         (Eq false (Ult 0 N2))]
        false)
