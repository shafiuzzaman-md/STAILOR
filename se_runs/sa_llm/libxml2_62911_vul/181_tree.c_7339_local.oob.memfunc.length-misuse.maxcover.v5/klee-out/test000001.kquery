array buf[32] : w32 -> w8 = symbolic
array newSize[4] : w32 -> w8 = symbolic
(query [(Ule 0
              N0:(ReadLSB w32 0 newSize))
         (Eq 2
             (ReadLSB w32 24 buf))
         (Eq false
             (Eq 0
                 N1:(ReadLSB w64 8 buf)))
         (Ule N1
              N2:(ReadLSB w64 0 buf))
         (Ult N3:(ReadLSB w32 16 buf)
              4096)
         (Ult N4:(ReadLSB w32 20 buf)
              4096)
         (Ult N0
              N5:(Extract w32 0 (Sub w64 N2 N1)))
         (Eq false
             (Ule N3 (Sub w32 N4 N5)))]
        false)
