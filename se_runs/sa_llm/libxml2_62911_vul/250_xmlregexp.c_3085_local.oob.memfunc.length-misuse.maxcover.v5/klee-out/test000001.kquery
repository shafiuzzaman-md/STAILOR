array len[4] : w32 -> w8 = symbolic
array maxRollbacks[4] : w32 -> w8 = symbolic
(query [(Sle 0
              (ReadLSB w32 0 len))
         (Sle 0
              N0:(ReadLSB w32 0 maxRollbacks))
         (Slt 0 N0)
         (Eq false
             (Eq 128
                 N1:(Mul w64 16 (SExt w64 N0))))
         (Eq false (Ult 2147483648 N1))]
        false)
