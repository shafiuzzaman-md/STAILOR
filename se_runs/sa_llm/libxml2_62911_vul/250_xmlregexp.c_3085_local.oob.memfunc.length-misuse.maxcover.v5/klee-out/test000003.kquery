array len[4] : w32 -> w8 = symbolic
array maxRollbacks[4] : w32 -> w8 = symbolic
(query [(Sle 0
              N0:(ReadLSB w32 0 len))
         (Sle 0
              N1:(ReadLSB w32 0 maxRollbacks))
         (Slt 0 N1)
         (Eq 128
             (Mul w64 16 (SExt w64 N1)))
         (Eq false
             (Sle 0 (Sub w32 N1 N0)))]
        false)
