array lenn[4] : w32 -> w8 = symbolic
array lenp[4] : w32 -> w8 = symbolic
array token[100] : w32 -> w8 = symbolic
array token2[100] : w32 -> w8 = symbolic
(query [(Sle 0
              N0:(ReadLSB w32 0 lenp))
         (Slt N0 100)
         (Sle 0
              N1:(ReadLSB w32 0 lenn))
         (Slt N1 100)
         (Eq 0
             (Read w8 (Extract w32 0 (SExt w64 N0))
                      token))
         (Eq 0
             (Read w8 (Extract w32 0 (SExt w64 N1))
                      token2))
         (Eq false
             (Eq 0 (Add w32 N1 N0)))]
        false)
