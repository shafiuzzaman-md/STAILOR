array curseg[4] : w32 -> w8 = symbolic
array len[8] : w32 -> w8 = symbolic
array rlen[8] : w32 -> w8 = symbolic
(query [(Ule 0
              N0:(ReadLSB w64 0 len))
         (Ule 0
              N1:(ReadLSB w64 0 rlen))
         (Sle 0
              N2:(ReadLSB w32 0 curseg))
         (Ule N1 N0)
         (Eq false (Sle 101 N2))]
        false)
