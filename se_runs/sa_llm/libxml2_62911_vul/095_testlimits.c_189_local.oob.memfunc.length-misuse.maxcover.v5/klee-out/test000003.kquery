array curlen[4] : w32 -> w8 = symbolic
array dotlen[4] : w32 -> w8 = symbolic
array len[4] : w32 -> w8 = symbolic
array maxlen[4] : w32 -> w8 = symbolic
array rlen[4] : w32 -> w8 = symbolic
(query [(Sle 0
              N0:(ReadLSB w32 0 rlen))
         (Sle 0
              (ReadLSB w32 0 curlen))
         (Sle 0
              (ReadLSB w32 0 dotlen))
         (Sle N0 0)
         (Eq 0
             (ReadLSB w32 0 maxlen))
         (Eq 0
             (ReadLSB w32 0 len))]
        false)
