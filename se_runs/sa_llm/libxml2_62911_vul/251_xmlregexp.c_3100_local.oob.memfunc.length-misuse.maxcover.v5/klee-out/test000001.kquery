array nbCounters[4] : w32 -> w8 = symbolic
array nbRollbacks[4] : w32 -> w8 = symbolic
array rollbacks_size[4] : w32 -> w8 = symbolic
(query [(Sle 0
              N0:(ReadLSB w32 0 nbCounters))
         (Sle N0 100)
         (Sle 0
              N1:(ReadLSB w32 0 nbRollbacks))
         (Slt N1
              N2:(ReadLSB w32 0 rollbacks_size))
         (Slt 0 N2)
         (Sle N2 100)
         (Eq false
             (Eq 0
                 (Mul w64 4 (SExt w64 N0))))]
        false)
