array A[8] : w32 -> w8 = symbolic
array B[8] : w32 -> w8 = symbolic
array curr[8] : w32 -> w8 = symbolic
(query [(Ult 0
              N0:(ReadLSB w64 0 A))
         (Ult 0
              N1:(ReadLSB w64 0 B))
         (Ule 0
              N2:(ReadLSB w64 0 curr))
         (Eq 1020
             (Mul w64 4
                      (Add w64 (Add w64 N2 N0) N1)))
         (Eq false (Ult N0 N1))
         (Eq false
             (Eq 0 N3:(Mul w64 4 N1)))
         (Eq false (Eq 128 N3))
         (Eq false (Ult 2147483648 N3))]
        false)
