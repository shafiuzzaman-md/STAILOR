array inlen[4] : w32 -> w8 = symbolic
array ptr_offset[4] : w32 -> w8 = symbolic
array rptr_offset[4] : w32 -> w8 = symbolic
(query [(Eq 0
             (ReadLSB w32 0 inlen))
         (Sle 0
              N0:(ReadLSB w32 0 rptr_offset))
         (Sle N0 0)
         (Sle N0
              N1:(ReadLSB w32 0 ptr_offset))
         (Sle N1 0)]
        false)
