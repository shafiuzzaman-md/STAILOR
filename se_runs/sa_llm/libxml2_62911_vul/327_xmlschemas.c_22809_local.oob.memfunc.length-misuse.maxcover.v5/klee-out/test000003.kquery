array nbFields[4] : w32 -> w8 = symbolic
array pos[4] : w32 -> w8 = symbolic
(query [(Sle 0
              N0:(ReadLSB w32 0 nbFields))
         (Slt N0 1000)
         (Sle 0
              N1:(ReadLSB w32 0 pos))
         (Slt N1 100)
         (Eq false
             (Eq 0
                 (Mul w64 8 (SExt w64 N0))))]
        false)
