array lenn[4] : w32 -> w8 = symbolic
array lenp[4] : w32 -> w8 = symbolic
array memory_size[4] : w32 -> w8 = symbolic
(query [(Sle 0
              N0:(ReadLSB w32 0 memory_size))
         (Eq false (Slt N0 195))
         (Eq 67
             (ReadLSB w32 0 lenp))
         (Eq 126
             (ReadLSB w32 0 lenn))
         (Eq false (Eq 195 N0))]
        false)
