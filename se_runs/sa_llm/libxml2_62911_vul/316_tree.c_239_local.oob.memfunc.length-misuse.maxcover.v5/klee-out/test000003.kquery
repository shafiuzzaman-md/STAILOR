array lenn[4] : w32 -> w8 = symbolic
array lenp[4] : w32 -> w8 = symbolic
array memory_size[4] : w32 -> w8 = symbolic
(query [(Sle 0
              N0:(ReadLSB w32 0 lenn))
         (Sle 0
              N1:(ReadLSB w32 0 memory_size))
         (Eq false
             (Slt N1 (Add w32 69 N0)))
         (Eq 67
             (ReadLSB w32 0 lenp))
         (Eq false (Eq 126 N0))
         (Eq false
             (Ult 2147483648
                  (SExt w64 (Add w32 1 N0))))]
        false)
