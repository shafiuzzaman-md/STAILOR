array curlen[4] : w32 -> w8 = symbolic
array currentTest[4] : w32 -> w8 = symbolic
array instate[4] : w32 -> w8 = symbolic
array len[4] : w32 -> w8 = symbolic
array maxlen[4] : w32 -> w8 = symbolic
array rlen[4] : w32 -> w8 = symbolic
(query [(Eq 1
             (ReadLSB w32 0 instate))
         (Sle 0
              N0:(ReadLSB w32 0 currentTest))
         (Slt N0 10)
         (Sle 0
              N1:(ReadLSB w32 0 curlen))
         (Sle 0
              N2:(ReadLSB w32 0 maxlen))
         (Sle 0
              (ReadLSB w32 0 rlen))
         (Sle 0
              N3:(ReadLSB w32 0 len))
         (Eq false (Slt 4096 N3))
         (Eq false
             (Ult 0 (SExt w64 N3)))
         (Sle N2 (Add w32 N1 N3))]
        false)
