array len[4] : w32 -> w8 = symbolic
array str1[100] : w32 -> w8 = symbolic
(query [(Eq false
             (Eq 0 N0:(Read w8 0 str1)))
         (Sle 0
              N1:(ReadLSB w32 0 len))
         (Eq false
             (Slt (SExt w32 N0) 0))
         (Eq false
             (Ult 999 N2:(SExt w64 N1)))
         (Eq false (Ult N2 100))]
        false)
