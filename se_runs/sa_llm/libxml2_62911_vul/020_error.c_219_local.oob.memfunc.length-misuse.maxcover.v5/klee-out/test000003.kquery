array len[4] : w32 -> w8 = symbolic
array len_1[4] : w32 -> w8 = symbolic
array len_2[4] : w32 -> w8 = symbolic
array len_3[4] : w32 -> w8 = symbolic
array len_4[4] : w32 -> w8 = symbolic
array len_5[4] : w32 -> w8 = symbolic
array str1[100] : w32 -> w8 = symbolic
(query [(Eq false
             (Eq 0 N0:(Read w8 0 str1)))
         (Sle 0
              N1:(ReadLSB w32 0 len))
         (Eq false
             (Slt (SExt w32 N0) 0))
         (Eq false
             (Ult 999 N2:(SExt w64 N1)))
         (Ult N2 100)
         (Eq false
             (Eq 0
                 N3:(Read w8 (Extract w32 0 N2)
                             U0:[99=0] @ str1)))
         (Sle 0
              N4:(ReadLSB w32 0 len_1))
         (Eq false
             (Slt (SExt w32 N3) 0))
         (Eq false
             (Ult 999
                  (SExt w64 N5:(Add w32 N1 N4))))
         (Ult N6:(Add w64 N2 (SExt w64 N4))
              100)
         (Eq false
             (Eq 0
                 N7:(Read w8 (Extract w32 0 N6)
                             U0)))
         (Sle 0
              N8:(ReadLSB w32 0 len_2))
         (Eq false
             (Slt (SExt w32 N7) 0))
         (Eq false
             (Ult 999
                  (SExt w64 N9:(Add w32 N5 N8))))
         (Ult N10:(Add w64 N6 (SExt w64 N8))
              100)
         (Eq false
             (Eq 0
                 N11:(Read w8 (Extract w32 0 N10)
                              U0)))
         (Sle 0
              N12:(ReadLSB w32 0 len_3))
         (Eq false
             (Slt (SExt w32 N11) 0))
         (Eq false
             (Ult 999
                  (SExt w64 N13:(Add w32 N9 N12))))
         (Ult N14:(Add w64 N10 (SExt w64 N12))
              100)
         (Eq false
             (Eq 0
                 N15:(Read w8 (Extract w32 0 N14)
                              U0)))
         (Sle 0
              N16:(ReadLSB w32 0 len_4))
         (Eq false
             (Slt (SExt w32 N15) 0))
         (Eq false
             (Ult 999
                  (SExt w64 N17:(Add w32 N13 N16))))
         (Ult N18:(Add w64 N14 (SExt w64 N16))
              100)
         (Eq false
             (Eq 0
                 N19:(Read w8 (Extract w32 0 N18)
                              U0)))
         (Sle 0
              N20:(ReadLSB w32 0 len_5))
         (Eq false
             (Slt (SExt w32 N19) 0))
         (Eq false
             (Ult 999
                  (SExt w64 (Add w32 N17 N20))))
         (Ult (Add w64 N18 (SExt w64 N20))
              100)]
        false)
