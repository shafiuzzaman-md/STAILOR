array len[4] : w32 -> w8 = symbolic
array n[4] : w32 -> w8 = symbolic
(query [(Slt 0
              N0:(ReadLSB w32 0 n))
         (Ule N1:(SExt w64 N0) 1023)
         (Sle 0
              (ReadLSB w32 0 len))
         (Eq false
             (Ult 0 (Add w64 18446744073709551615 N1)))]
        false)
