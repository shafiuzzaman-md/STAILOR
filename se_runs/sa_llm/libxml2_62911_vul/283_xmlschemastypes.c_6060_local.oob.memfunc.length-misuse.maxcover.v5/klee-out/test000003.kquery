array dec_total[4] : w32 -> w8 = symbolic
array i[4] : w32 -> w8 = symbolic
array offs[256] : w32 -> w8 = symbolic
(query [(Sle 0
              N0:(ReadLSB w32 0 i))
         (Sle 0
              N1:(ReadLSB w32 0 dec_total))
         (Sle N1 256)
         (Ult N2:(SExt w64 N0) 256)
         (Eq 0
             (Read w8 (Extract w32 0 N2)
                      offs))
         (Slt N0 N1)]
        false)
