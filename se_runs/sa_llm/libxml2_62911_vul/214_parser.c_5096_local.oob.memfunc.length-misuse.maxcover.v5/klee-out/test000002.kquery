array len[4] : w32 -> w8 = symbolic
array maxLength[4] : w32 -> w8 = symbolic
array nbchar[4] : w32 -> w8 = symbolic
(query [(Sle 0
              N0:(ReadLSB w32 0 maxLength))
         (Sle 0
              N1:(ReadLSB w32 0 len))
         (Sle 0
              N2:(ReadLSB w32 0 nbchar))
         (Slt N0 1024)
         (Slt N1 1024)
         (Slt N2 1024)
         (Eq false
             (Slt N0
                  (Add w32 1 (Add w32 N1 N2))))]
        false)
