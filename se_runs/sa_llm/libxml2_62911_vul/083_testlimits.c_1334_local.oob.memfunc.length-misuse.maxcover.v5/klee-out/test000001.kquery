array fail[4] : w32 -> w8 = symbolic
array filename[256] : w32 -> w8 = symbolic
(query [(Eq false
             (Eq 0
                 (ReadLSB w32 0 fail)))
         (Eq 99 (Read w8 0 filename))
         (Eq 114 (Read w8 1 filename))
         (Eq 97 (Read w8 2 filename))
         (Eq 122 (Read w8 3 filename))
         (Eq 121 (Read w8 4 filename))
         (Eq 58 (Read w8 5 filename))]
        false)
