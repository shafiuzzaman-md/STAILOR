array lengths[12] : w32 -> w8 = symbolic
(query [(Sle 0
              N0:(ReadLSB w32 4 lengths))
         (Slt N0 1024)
         (Sle 0
              N1:(ReadLSB w32 8 lengths))
         (Slt N1 1024)
         (Eq 0
             (ReadLSB w32 0 lengths))
         (Eq false (Eq 0 N0))]
        false)
