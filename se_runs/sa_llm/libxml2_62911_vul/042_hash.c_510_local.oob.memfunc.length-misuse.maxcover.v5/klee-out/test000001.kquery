array lengths[12] : w32 -> w8 = symbolic
(query [(Sle 0
              (ReadLSB w32 0 lengths))
         (Sle 0
              (ReadLSB w32 4 lengths))
         (Sle 0
              N0:(ReadLSB w32 8 lengths))
         (Eq false (Eq 0 N0))
         (Eq false
             (Ult 2147483648
                  (SExt w64 (Add w32 1 N0))))]
        false)
