array A[4] : w32 -> w8 = symbolic
array B[4] : w32 -> w8 = symbolic
array curr[4] : w32 -> w8 = symbolic
(query [(Slt N0:(ReadLSB w32 0 B)
              N1:(ReadLSB w32 0 A))
         (Slt 0 N1)
         (Slt 0 N0)
         (Sle 0
              N2:(ReadLSB w32 0 curr))
         (Sle N2 1000)
         (Sle N1 100)
         (Sle N0 100)
         (Ult (Mul w64 4
                       (SExt w64 (Add w32 N2 N1)))
              4096)
         (Eq false
             (Ult 0
                  (Add w64 18446744073709551612
                           (Mul w64 4 (SExt w64 N0)))))]
        false)
