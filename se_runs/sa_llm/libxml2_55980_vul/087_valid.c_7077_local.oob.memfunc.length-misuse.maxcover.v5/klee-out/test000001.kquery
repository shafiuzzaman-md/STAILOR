array max[4] : w32 -> w8 = symbolic
array use_next[4] : w32 -> w8 = symbolic
array use_prev[4] : w32 -> w8 = symbolic
(query [(Eq false
             (Eq 0
                 (ReadLSB w32 0 use_prev)))
         (Eq 0
             (ReadLSB w32 0 use_next))
         (Slt 0
              (ReadLSB w32 0 max))]
        false)
