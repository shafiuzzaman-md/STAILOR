array bufsize[4] : w32 -> w8 = symbolic
array dec_total[4] : w32 -> w8 = symbolic
array null_pos[4] : w32 -> w8 = symbolic
(query [(Slt 0
              N0:(ReadLSB w32 0 dec_total))
         (Sle N0 100)
         (Eq 1
             (ReadLSB w32 0 bufsize))
         (Eq false
             (Sle 0
                  (ReadLSB w32 0 null_pos)))]
        false)
