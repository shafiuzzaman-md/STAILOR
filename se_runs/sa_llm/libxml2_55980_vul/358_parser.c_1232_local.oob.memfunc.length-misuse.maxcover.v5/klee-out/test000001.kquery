array buffer_size[4] : w32 -> w8 = symbolic
array len_val[4] : w32 -> w8 = symbolic
array remove_head[4] : w32 -> w8 = symbolic
(query [(Slt 0
              (ReadLSB w32 0 remove_head))
         (Slt 0
              (ReadLSB w32 0 len_val))
         (Slt 0
              N0:(ReadLSB w32 0 buffer_size))
         (Sle N0 4096)
         (Eq false (Eq 1 N0))]
        false)
