array currentTest[4] : w32 -> w8 = symbolic
array instate[4] : w32 -> w8 = symbolic
array len[8] : w32 -> w8 = symbolic
(query [(Eq 1
             (ReadLSB w32 0 instate))
         (Sle 0
              N0:(ReadLSB w32 0 currentTest))
         (Slt N0 10)
         (Eq false
             (Ult 4096
                  (ReadLSB w64 0 len)))]
        false)
