array buffersize[4] : w32 -> w8 = symbolic
array str[256] : w32 -> w8 = symbolic
(query [(Slt 0
              N0:(ReadLSB w32 0 buffersize))
         (Sle N0 256)
         (Eq false
             (Eq 0 N1:(Read w8 0 str)))
         (Eq false (Eq 46 N1))
         (Eq 0 (Read w8 1 str))]
        false)
