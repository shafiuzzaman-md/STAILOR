array dict_size[4] : w32 -> w8 = symbolic
array keep_keys[4] : w32 -> w8 = symbolic
(query [(Ult 0
              N0:(ReadLSB w32 0 dict_size))
         (Ult N0 1024)
         (Eq 1
             (ReadLSB w32 0 keep_keys))
         (Eq false
             (Eq 10200
                 (Mul w64 40 (ZExt w64 N0))))]
        false)
