array exec[40] : w32 -> w8 = symbolic
array nbCounters[4] : w32 -> w8 = symbolic
(query [(Sle 0
              N0:(ReadLSB w32 8 exec))
         (Slt N0 100)
         (Eq 8
             (Mul w64 8
                      (SExt w64 (Add w32 1 N0))))
         (Sle 0
              N1:(ReadLSB w32 0 nbCounters))
         (Slt N1 1000)
         (Eq false (Slt 0 N1))]
        false)
