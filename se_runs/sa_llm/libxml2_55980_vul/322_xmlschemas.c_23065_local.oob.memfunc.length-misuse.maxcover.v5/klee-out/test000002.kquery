array nbFields[4] : w32 -> w8 = symbolic
array pos[4] : w32 -> w8 = symbolic
(query [(Sle 0
              N0:(ReadLSB w32 0 pos))
         (Slt N0 10)
         (Eq false
             (Eq 0
                 N1:(Mul w64 8
                             (SExt w64 (ReadLSB w32 0 nbFields)))))
         (Eq false (Ult 2147483648 N1))]
        false)
