array alias[256] : w32 -> w8 = symbolic
array alias_str[256] : w32 -> w8 = symbolic
array alias_str_1[256] : w32 -> w8 = symbolic
array alias_str_2[256] : w32 -> w8 = symbolic
array alias_str_3[256] : w32 -> w8 = symbolic
array array_size[4] : w32 -> w8 = symbolic
array name[256] : w32 -> w8 = symbolic
array name_1[256] : w32 -> w8 = symbolic
array name_2[256] : w32 -> w8 = symbolic
array name_3[256] : w32 -> w8 = symbolic
(query [(Eq 0 (Read w8 255 alias))
         (Sle 0
              N0:(ReadLSB w32 0 array_size))
         (Sle N0 100)
         (Slt 0 N0)
         (Eq 64
             (Mul w64 16 (SExt w64 N0)))
         (Eq 0 (Read w8 255 name))
         (Eq 0 (Read w8 255 alias_str))
         (Eq 0 (Read w8 255 name_1))
         (Eq 0 (Read w8 255 alias_str_1))
         (Eq 0 (Read w8 255 name_2))
         (Eq 0 (Read w8 255 alias_str_2))
         (Eq 0 (Read w8 255 name_3))
         (Eq 0 (Read w8 255 alias_str_3))]
        false)
