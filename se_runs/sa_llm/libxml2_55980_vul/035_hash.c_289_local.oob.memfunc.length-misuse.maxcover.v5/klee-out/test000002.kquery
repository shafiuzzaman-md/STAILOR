array iter[48] : w32 -> w8 = symbolic
array key[4] : w32 -> w8 = symbolic
array table_size[4] : w32 -> w8 = symbolic
(query [(Slt 0
              N0:(ReadLSB w32 0 table_size))
         (Slt N0 1000)
         (Eq 48
             (Mul w64 48 (SExt w64 N0)))
         (Eq 0
             (ReadLSB w64 0 iter))
         (Eq false
             (Eq 0
                 (ReadLSB w64 8 iter)))
         (Eq 0
             (ReadLSB w64 16 iter))
         (Sle 0
              N1:(ReadLSB w32 0 key))
         (Slt N1 N0)]
        false)
