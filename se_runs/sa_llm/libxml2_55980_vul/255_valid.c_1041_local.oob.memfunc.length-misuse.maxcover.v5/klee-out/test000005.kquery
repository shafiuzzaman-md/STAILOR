array continue_list[4] : w32 -> w8 = symbolic
array continue_list_1[4] : w32 -> w8 = symbolic
array dict[8] : w32 -> w8 = symbolic
array list_node[32] : w32 -> w8 = symbolic
array list_node_1[32] : w32 -> w8 = symbolic
(query [(Sle 0
              N0:(ReadLSB w32 0 list_node))
         (Sle N0 10)
         (Sle 0
              N1:(ReadLSB w32 4 list_node))
         (Sle N1 10)
         (Eq 1
             (ReadLSB w32 0 continue_list))
         (Sle 0
              N2:(ReadLSB w32 0 list_node_1))
         (Sle N2 10)
         (Sle 0
              N3:(ReadLSB w32 4 list_node_1))
         (Sle N3 10)
         (Eq 0
             (ReadLSB w32 0 continue_list_1))
         (Eq 0
             (ReadLSB w64 0 dict))]
        false)
