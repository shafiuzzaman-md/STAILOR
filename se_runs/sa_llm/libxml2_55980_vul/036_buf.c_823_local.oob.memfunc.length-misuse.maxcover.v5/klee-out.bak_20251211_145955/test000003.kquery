array initial_size[8] : w32 -> w8 = symbolic
array initial_use[8] : w32 -> w8 = symbolic
array len[8] : w32 -> w8 = symbolic
(query [(Ult 0
              N0:(ReadLSB w64 0 initial_size))
         (Ule N0 1024)
         (Ult (ReadLSB w64 0 initial_use)
              N0)
         (Ult 0
              N1:(ReadLSB w64 0 len))
         (Ule N1 1024)
         (Eq false (Eq 127 N0))]
        false)
