array initial_size[8] : w32 -> w8 = symbolic
array initial_use[8] : w32 -> w8 = symbolic
array len[8] : w32 -> w8 = symbolic
(query [(Ult N0:(ReadLSB w64 0 initial_use)
              127)
         (Eq 127
             (ReadLSB w64 0 initial_size))
         (Eq false (Ult 0 N0))
         (Eq 128
             (ReadLSB w64 0 len))]
        false)
