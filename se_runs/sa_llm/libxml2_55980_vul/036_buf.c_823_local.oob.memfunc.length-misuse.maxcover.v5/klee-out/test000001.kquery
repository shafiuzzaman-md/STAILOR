array buf_size[4] : w32 -> w8 = symbolic
array buf_use[4] : w32 -> w8 = symbolic
array str_len[4] : w32 -> w8 = symbolic
(query [(Ule N0:(ReadLSB w32 0 buf_size)
              1048576)
         (Ule (ReadLSB w32 0 buf_use)
              N0)
         (Ule (ReadLSB w32 0 str_len)
              1048576)
         (Eq false (Eq 0 N0))]
        false)
