array curseg[4] : w32 -> w8 = symbolic
array len[4] : w32 -> w8 = symbolic
array rlen[4] : w32 -> w8 = symbolic
(query [(Sle 0
              N0:(ReadLSB w32 0 len))
         (Sle 0
              N1:(ReadLSB w32 0 rlen))
         (Sle 0
              N2:(ReadLSB w32 0 curseg))
         (Slt N2 1001)
         (Sle N1 N0)
         (Eq false (Sle N1 1024))]
        false)
