array nbCounters[4] : w32 -> w8 = symbolic
array progress[4] : w32 -> w8 = symbolic
(query [(Eq false
             (Eq 0
                 (ReadLSB w32 0 progress)))
         (Slt 0
              N0:(ReadLSB w32 0 nbCounters))
         (Eq false
             (Eq 4
                 N1:(Mul w64 4 (SExt w64 N0))))
         (Eq false (Ult 2147483648 N1))]
        false)
