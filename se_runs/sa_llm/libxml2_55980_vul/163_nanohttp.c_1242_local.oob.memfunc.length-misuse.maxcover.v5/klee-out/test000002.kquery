array bytes_received[4] : w32 -> w8 = symbolic
array ctxt[24] : w32 -> w8 = symbolic
array len[4] : w32 -> w8 = symbolic
(query [(Slt 0
              N0:(ReadLSB w32 0 len))
         (Sle N0 1024)
         (Eq false
             (Eq 0
                 N1:(ReadLSB w64 0 ctxt)))
         (Eq false
             (Eq 0
                 N2:(ReadLSB w64 8 ctxt)))
         (Ule N2 N1)
         (Ule N3:(Sub w64 N1 N2) 2048)
         (Eq false (Ult 0 N3))
         (Eq false
             (Sle 4294967295
                  (ReadLSB w32 0 bytes_received)))]
        false)
