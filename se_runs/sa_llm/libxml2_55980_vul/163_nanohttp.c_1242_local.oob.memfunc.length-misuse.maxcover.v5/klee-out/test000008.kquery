array bytes_received[4] : w32 -> w8 = symbolic
array ctxt[24] : w32 -> w8 = symbolic
array len[4] : w32 -> w8 = symbolic
(query [(Slt 0
              N0:(ReadLSB w32 0 len))
         (Sle N0 1024)
         (Eq false
             (Eq 0
                 N1:(ReadLSB w64 8 ctxt)))
         (Ule N1 135499046541032)
         (Ule N2:(Sub w64 135499046541032 N1) 2048)
         (Eq false (Ult 0 N2))
         (Eq 128
             (ReadLSB w32 0 bytes_received))
         (Eq 135499046541032
             (ReadLSB w64 0 ctxt))]
        false)
