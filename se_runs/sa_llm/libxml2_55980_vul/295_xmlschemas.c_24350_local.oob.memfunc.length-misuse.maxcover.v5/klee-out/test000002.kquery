array vctxt[16] : w32 -> w8 = symbolic
(query [(Sle 0
              N0:(ReadLSB w32 12 vctxt))
         (Slt N0 1000)
         (Sle 0
              N1:(ReadLSB w32 8 vctxt))
         (Slt N1 1000)
         (Eq false (Sle N1 N0))
         (Eq 136975961030656
             (ReadLSB w64 0 vctxt))]
        false)
