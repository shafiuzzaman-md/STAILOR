array vctxt[16] : w32 -> w8 = symbolic
(query [(Sle 0
              N0:(ReadLSB w32 12 vctxt))
         (Slt N0 1000)
         (Sle 0
              N1:(ReadLSB w32 8 vctxt))
         (Slt N1 1000)
         (Sle N1 N0)
         (Eq 0
             (Mul w64 8
                      (SExt w64 (Mul w32 2 N1))))
         (Eq 138202778173440
             (ReadLSB w64 0 vctxt))]
        false)
