array buffer_size[8] : w32 -> w8 = symbolic
array checkIndex[4] : w32 -> w8 = symbolic
array cur_offset[8] : w32 -> w8 = symbolic
(query [(Ule 1
              N0:(ReadLSB w64 0 buffer_size))
         (Ule N0 1024)
         (Ult (ReadLSB w64 0 cur_offset)
              N0)
         (Sle 0
              N1:(ReadLSB w32 0 checkIndex))
         (Slt N1
              N2:(ReadLSB w32 0 buffer_size))
         (Eq false (Eq 1 N0))]
        false)
