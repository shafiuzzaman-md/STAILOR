array nodeTab_size[4] : w32 -> w8 = symbolic
array nsTab_size[4] : w32 -> w8 = symbolic
(query [(Sle 0
              N0:(ReadLSB w32 0 nsTab_size))
         (Sle N0 1024)
         (Sle 0
              N1:(ReadLSB w32 0 nodeTab_size))
         (Sle N1 1024)
         (Slt 0 N0)
         (Eq false
             (Eq 128
                 (Mul w64 8 (SExt w64 N0))))]
        false)
