array lenn[4] : w32 -> w8 = symbolic
array lenp[4] : w32 -> w8 = symbolic
(query [(Sle 0
              N0:(ReadLSB w32 0 lenp))
         (Slt N0 256)
         (Sle 0
              N1:(ReadLSB w32 0 lenn))
         (Slt N1 256)
         (Eq false
             (Slt 256
                  (Add w32 2 (Add w32 N1 N0))))
         (Eq false
             (Ult 0 (SExt w64 N0)))
         (Eq false
             (Ult 0 (SExt w64 N1)))]
        false)
