array dim1[8] : w32 -> w8 = symbolic
array dim2[8] : w32 -> w8 = symbolic
array elemSize[8] : w32 -> w8 = symbolic
(query [(Ule (ReadLSB w64 0 dim1)
              1024)
         (Ule N0:(ReadLSB w64 0 elemSize)
              1024)
         (Ult 0 N0)
         (Eq 0
             (ReadLSB w64 0 dim2))]
        false)
