array baseFilename_result[256] : w32 -> w8 = symbolic
array filename[256] : w32 -> w8 = symbolic
array out[256] : w32 -> w8 = symbolic
array suffix[500] : w32 -> w8 = symbolic
(query [(Eq 0 (Read w8 255 filename))
         (Eq 0 (Read w8 499 suffix))
         (Eq 0 (Read w8 255 out))
         (Eq 0 (Read w8 255 baseFilename_result))]
        false)
