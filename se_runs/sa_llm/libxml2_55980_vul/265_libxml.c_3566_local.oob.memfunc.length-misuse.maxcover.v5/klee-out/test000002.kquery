array count[4] : w32 -> w8 = symbolic
array is_tuple[4] : w32 -> w8 = symbolic
(query [(Slt 0
              N0:(ReadLSB w32 0 count))
         (Eq 1
             (ReadLSB w32 0 is_tuple))
         (Eq false
             (Eq 8
                 N1:(Mul w64 8 (SExt w64 N0))))
         (Ult 2147483648 N1)]
        false)
