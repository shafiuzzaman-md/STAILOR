array len[4] : w32 -> w8 = symbolic
array uptr[256] : w32 -> w8 = symbolic
(query [(Slt 0
              N0:(ReadLSB w32 0 len))
         (Slt N0 256)
         (Eq false
             (Eq 47 (Read w8 0 uptr)))
         (Ult 0
              (Add w64 18446744073709551615 N1:(SExt w64 N0)))
         (Eq false
             (Ult 0 (Add w64 18446744073709551614 N1)))]
        false)
