array fail[4] : w32 -> w8 = symbolic
array read_ret[4] : w32 -> w8 = symbolic
array ret[4] : w32 -> w8 = symbolic
(query [(Eq 0
             (ReadLSB w32 0 fail))
         (Eq false
             (Eq 0
                 (ReadLSB w32 0 ret)))
         (Eq 4294967295
             (ReadLSB w32 0 read_ret))]
        false)
