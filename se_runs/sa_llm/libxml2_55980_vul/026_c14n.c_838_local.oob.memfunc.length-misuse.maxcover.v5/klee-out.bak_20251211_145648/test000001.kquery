array has_empty_ns[4] : w32 -> w8 = symbolic
array has_empty_ns_in_inclusive_list[4] : w32 -> w8 = symbolic
array visible[4] : w32 -> w8 = symbolic
(query [(Eq false
             (Eq 0
                 (ReadLSB w32 0 visible)))
         (Eq 0
             (ReadLSB w32 0 has_empty_ns))
         (Eq false
             (Eq 0
                 (ReadLSB w32 0 has_empty_ns_in_inclusive_list)))]
        false)
