array nodeNr[4] : w32 -> w8 = symbolic
array nodeNr_1[4] : w32 -> w8 = symbolic
(query [(Sle 0
              N0:(ReadLSB w32 0 nodeNr))
         (Sle N0 10)
         (Slt 0 N0)
         (Eq 24
             (Mul w64 8 (SExt w64 N0)))
         (Sle 0
              N1:(ReadLSB w32 0 nodeNr_1))
         (Sle N1 10)
         (Slt 0 N1)
         (Eq 24
             (Mul w64 8 (SExt w64 N1)))]
        false)
