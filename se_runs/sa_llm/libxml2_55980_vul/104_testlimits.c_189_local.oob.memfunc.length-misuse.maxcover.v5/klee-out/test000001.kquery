array context[4] : w32 -> w8 = symbolic
array instate[4] : w32 -> w8 = symbolic
array len[4] : w32 -> w8 = symbolic
array rlen[4] : w32 -> w8 = symbolic
(query [(Eq false
             (Eq 0
                 (ReadLSB w32 0 context)))
         (Sle 0
              N0:(ReadLSB w32 0 len))
         (Eq 0
             (ReadLSB w32 0 instate))
         (Sle N1:(ReadLSB w32 0 rlen)
              N0)
         (Sle 0 N1)
         (Sle N1 200)
         (Eq false
             (Ult 0 (SExt w64 N1)))]
        false)
