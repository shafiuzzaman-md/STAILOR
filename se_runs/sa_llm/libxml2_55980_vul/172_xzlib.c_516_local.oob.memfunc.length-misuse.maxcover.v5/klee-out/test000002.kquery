array avail_in[4] : w32 -> w8 = symbolic
array have[4] : w32 -> w8 = symbolic
array out_buf_size[4] : w32 -> w8 = symbolic
(query [(Ult 0
              N0:(ReadLSB w32 0 out_buf_size))
         (Ule N0 1048576)
         (Ule (ReadLSB w32 0 have)
              N0)
         (Ule (ReadLSB w32 0 avail_in)
              1048576)
         (Eq false (Eq 127 N0))]
        false)
