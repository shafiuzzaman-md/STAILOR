array avail_in[4] : w32 -> w8 = symbolic
array have[4] : w32 -> w8 = symbolic
array out_buf_size[4] : w32 -> w8 = symbolic
(query [(Ule (ReadLSB w32 0 have)
              127)
         (Ule N0:(ReadLSB w32 0 avail_in)
              1048576)
         (Eq 127
             (ReadLSB w32 0 out_buf_size))
         (Eq false (Ult 0 N0))]
        false)
