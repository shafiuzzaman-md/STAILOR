array instate[4] : w32 -> w8 = symbolic
array len[8] : w32 -> w8 = symbolic
array rlen[8] : w32 -> w8 = symbolic
(query [(Eq 0
             (ReadLSB w32 0 instate))
         (Ult N0:(ReadLSB w64 0 len)
              N1:(ReadLSB w64 0 rlen))
         (Ult 0 N1)
         (Ult 0 N0)
         (Ule N1 1024)
         (Ule N0 1024)]
        false)
