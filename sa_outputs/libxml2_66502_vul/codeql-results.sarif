          "rules": [
            {
              "id": "shafi/cpp/pattern/free-then-deref/intra",
              "name": "shafi/cpp/pattern/free-then-deref/intra",
              "shortDescription": {
                "text": "CWE-416: Free-then-Dereference (intra-procedural)"
              },
              "fullDescription": {
                "text": "Detects intra-procedural use-after-free where a pointer freed by a deallocator (generic project frees) is later dereferenced: `*p`, `p->f`, or used as an array base. PATTERN (what this flags): In the same function, a pointer value that is freed flows to a dereference site: - dereference: *p - pointer-field access: p->f - array base: p[i] SCOPE: - Single function (fast intra-procedural) - Recognizes common deallocators (free/kfree/vfree/g_free/xfree/safe_free/cfree/av_free and functions ending with Delete/Destroy/Dispose/Free/Release/Unref/UnRef)"
              },
              "defaultConfiguration": {
                "enabled": true,
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-416"
                ],
                "description": "Detects intra-procedural use-after-free where a pointer freed by a deallocator\n (generic project frees) is later dereferenced: `*p`, `p->f`, or used as an array base.\n\n PATTERN (what this flags):\n   In the same function, a pointer value that is freed flows to a dereference site:\n     - dereference: *p\n     - pointer-field access: p->f\n     - array base: p[i]\n\n SCOPE:\n   - Single function (fast intra-procedural)\n   - Recognizes common deallocators (free/kfree/vfree/g_free/xfree/safe_free/cfree/av_free\n     and functions ending with Delete/Destroy/Dispose/Free/Release/Unref/UnRef)",
                "id": "shafi/cpp/pattern/free-then-deref/intra",
                "kind": "problem",
                "name": "CWE-416: Free-then-Dereference (intra-procedural)",
                "precision": "medium",
                "problem.severity": "error",
                "security-severity": "7.5",
                "shortDescription": "CWE-416 free-then-deref (intra; direct deref/ptr field/array)"
              }
            }
          ]
        },
